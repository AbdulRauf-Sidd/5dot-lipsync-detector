# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed -- .env.example is the only one that should be.

# --- Service identity ---
# Used for /model-cache/{SERVICE_NAME}/ and the webhook's service_name field.
SERVICE_NAME=lipsync

# --- SQS ---
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/lipsync-queue
IDLE_TIMEOUT_SECONDS=60

# --- Postgres (shared detection_requests / detection_chunks DB) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=changeme

# --- Webhook (core service) ---
WEBHOOK_URL=https://core-service.placeholder/webhook

# --- AWS (source video download from S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=5dot-storage

# --- Shared local state (bind-mounted, shared with the other 2 detection containers) ---
SHARED_JOBS_DIR=/tmp/shared_jobs
DOWNLOAD_WAIT_TIMEOUT_SECONDS=600

# --- Inference ---
CHUNK_LENGTH_SECONDS=5
